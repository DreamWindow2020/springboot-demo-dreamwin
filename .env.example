# Copy to .env for local runs (don't commit the real .env).
# On Render, set these as actual Environment Variables in the dashboard instead.

# From Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (recommended for JDBC)
# Looks like: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_POOLER_HOST>:5432/postgres?sslmode=require

# Usually "postgres.<project-ref>" for the pooler, or "postgres" for a direct connection
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>

SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>

# Local port (Render sets this automatically in production)
PORT=8080
